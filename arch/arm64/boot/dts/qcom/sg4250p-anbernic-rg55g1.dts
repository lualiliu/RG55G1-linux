// SPDX-License-Identifier: GPL-2.0
/*
 * Anbernic RG55G1 board DT — from Luali Liu
 *  with:
 *  - explicit /memory for mainline bootmem
 *  - simple-framebuffer @ 0xb8000000 for continuous splash console
 *  - board-id 0x1000b (Ravelin QRD)
 *
 * Do not #include sm4450.dtsi here; stock already describes the SoC.
 */
/dts-v1/;

/ {
	model = "Anbernic RG55G1";
	compatible = "qcom,ravelinp";
	qcom,msm-id = <602 65536>;
	interrupt-parent = <1>;
	#address-cells = <2>;
	#size-cells = <2>;
	/* SoC DT uses 0; QRD board 0x1000b comes from stock dtbo */
	qcom,board-id = <0 0>;

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		stdout-path = "/chosen/framebuffer@b8000000";
		bootargs = "console=tty0 console=ttyMSM0,115200n8 loglevel=6 log_buf_len=256K kernel.panic_on_rcu_stall=1 loop.max_part=7 pcie_ports=compat msm_rtb.filter=0x237 kasan=off rcupdate.rcu_expedited=1 rcu_nocbs=0-7 ftrace_dump_on_oops pstore.compress=none kpti=0 swiotlb=noforce cgroup.memory=nokmem,nosocket kswapd_per_node=2 slub_debug=- allow_file_spec_access cpufreq.default_governor=performance transparent_hugepage=never can.stats_timer=0 disable_dma32=on android12_only.will_be_removed_soon.memblock_nomap_remove=on pcie_ports=compat";
		phandle = <506>;
		framebuffer@b8000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xb8000000 0x0 0x7e9000>;
			width = <1080>;
			height = <1920>;
			stride = <4320>;
			format = "x8r8g8b8";
		};
	};

	memory {
		device_type = "memory";
		/* Integrated from stock + explicit size for mainline bootmem */
		reg = <0x0 0x80000000 0x1 0x0>;
	};

	ddr-regions {
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		phandle = <507>;

		hyp_region@80000000 {
			no-map;
			reg = <0x0 0x80000000 0x0 0x600000>;
			phandle = <508>;
		};

		xbl_dtlog_region@80600000 {
			no-map;
			reg = <0x0 0x80600000 0x0 0x40000>;
			phandle = <509>;
		};

		/*
		 * Keep stock name for __symbols__, and add the exact name
		 * rocknix-abl looks up ("ramdump region not found" otherwise).
		 */
		xbl_ramdump_region@80640000 {
			no-map;
			reg = <0x0 0x80640000 0x0 0x1c0000>;
			phandle = <510>;
		};

		ramdump_region@80640000 {
			no-map;
			reg = <0x0 0x80640000 0x0 0x1c0000>;
		};

		aop_image_region@80800000 {
			no-map;
			reg = <0x0 0x80800000 0x0 0x60000>;
			phandle = <511>;
		};

		aop_cmd_db_region@80860000 {
			compatible = "qcom,cmd-db";
			no-map;
			reg = <0x0 0x80860000 0x0 0x20000>;
			phandle = <512>;
		};

		aop_config_region@80880000 {
			no-map;
			reg = <0x0 0x80880000 0x0 0x20000>;
			phandle = <513>;
		};

		tme_crash_dump_region@808a0000 {
			no-map;
			reg = <0x0 0x808a0000 0x0 0x40000>;
			phandle = <514>;
		};

		tme_log_region@808e0000 {
			no-map;
			reg = <0x0 0x808e0000 0x0 0x4000>;
			phandle = <515>;
		};

		uefi_log_region@808e4000 {
			no-map;
			reg = <0x0 0x808e4000 0x0 0x10000>;
			phandle = <516>;
		};

		chipinfo_region@808f4000 {
			no-map;
			reg = <0x0 0x808f4000 0x0 0x1000>;
			phandle = <392>;
		};

		smem_region@80900000 {
			no-map;
			reg = <0x0 0x80900000 0x0 0x200000>;
			phandle = <313>;
		};

		cpucp_fw_region@80b00000 {
			no-map;
			reg = <0x0 0x80b00000 0x0 0x100000>;
			phandle = <517>;
		};

		wlan_msa_mem_region@82a00000 {
			no-map;
			reg = <0x0 0x82a00000 0x0 0xc00000>;
			phandle = <497>;
		};

		camera_region@84b00000 {
			no-map;
			reg = <0x0 0x84b00000 0x0 0x800000>;
			phandle = <518>;
		};

		wpss_moselle_region@85300000 {
			no-map;
			reg = <0x0 0x85300000 0x0 0x1900000>;
			phandle = <348>;
		};

		video_region@86c00000 {
			no-map;
			reg = <0x0 0x86c00000 0x0 0x700000>;
			phandle = <519>;
		};

		adsp_region@87300000 {
			no-map;
			reg = <0x0 0x87300000 0x0 0x2100000>;
			phandle = <341>;
		};

		ipa_fw_region@89400000 {
			no-map;
			reg = <0x0 0x89400000 0x0 0x10000>;
			phandle = <520>;
		};

		ipa_gsi_region@89410000 {
			no-map;
			reg = <0x0 0x89410000 0x0 0xa000>;
			phandle = <351>;
		};

		gpu_microcode_region@8941a000 {
			no-map;
			reg = <0x0 0x8941a000 0x0 0x2000>;
			phandle = <52>;
		};

		mpss_region@8a000000 {
			no-map;
			reg = <0x0 0x8a000000 0x0 0xda00000>;
			phandle = <345>;
		};

		xbl_sc_region@a6e00000 {
			no-map;
			reg = <0x0 0xa6e00000 0x0 0x40000>;
			phandle = <521>;
		};

		global_sync_region@a6f00000 {
			no-map;
			reg = <0x0 0xa6f00000 0x0 0x100000>;
			phandle = <522>;
		};

		cpusys_vm_region@e0600000 {
			no-map;
			reg = <0x0 0xe0600000 0x0 0x400000>;
			phandle = <391>;
		};

		trust_ui_vm_region@e0b00000 {
			no-map;
			reg = <0x0 0xe0b00000 0x0 0x4af3000>;
			phandle = <390>;
		};

		trust_ui_vm_qrtr@e55f3000 {
			no-map;
			reg = <0x0 0xe55f3000 0x0 0x9000>;
			phandle = <386>;
		};

		trust_ui_vm_vblk0_ring@e55fc000 {
			no-map;
			reg = <0x0 0xe55fc000 0x0 0x4000>;
			gunyah-label = <17>;
			phandle = <387>;
		};

		trust_ui_vm_swiotlb@e5600000 {
			no-map;
			reg = <0x0 0xe5600000 0x0 0x100000>;
			gunyah-label = <18>;
			phandle = <388>;
		};

		tz_stat_region@e8800000 {
			no-map;
			reg = <0x0 0xe8800000 0x0 0x100000>;
			phandle = <523>;
		};

		tags_region@e8900000 {
			no-map;
			reg = <0x0 0xe8900000 0x0 0x680000>;
			phandle = <524>;
		};

		qtee_region@e8f80000 {
			no-map;
			reg = <0x0 0xe8f80000 0x0 0x500000>;
			phandle = <525>;
		};

		trusted_apps_region@e9480000 {
			no-map;
			reg = <0x0 0xe9480000 0x0 0x1200000>;
			phandle = <526>;
		};

		mem_dump_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0 0 0 4294967295>;
			reusable;
			alignment = <0 4194304>;
			size = <0 12582912>;
			phandle = <290>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			alloc-ranges = <0 0 0 4294967295>;
			reusable;
			alignment = <0 4194304>;
			size = <0 33554432>;
			linux,cma-default;
			phandle = <46>;
		};

		ramoops_region {
			compatible = "ramoops";
			alloc-ranges = <0 0 4294967295 4294967295>;
			size = <0 2097152>;
			record-size = <131072>;
			console-size = <1048576>;
			ftrace-size = <0>;
			pmsg-size = <262144>;
			mem-type = <0>;
			phandle = <527>;
		};

		va_md_mem_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <1 0 4294967294 4294967295>;
			reusable;
			size = <0 16777216>;
			phandle = <332>;
		};

		user_contig_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0 0 0 4294967295>;
			reusable;
			alignment = <0 4194304>;
			size = <0 16777216>;
			phandle = <53>;
		};

		qseecom_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0 0 0 4294967295>;
			reusable;
			alignment = <0 4194304>;
			size = <0 20971520>;
			phandle = <54>;
		};

		qseecom_ta_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0 0 0 4294967295>;
			reusable;
			alignment = <0 4194304>;
			size = <0 16777216>;
			phandle = <55>;
		};

		adsp_heap_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0 0 0 4294967295>;
			reusable;
			alignment = <0 4194304>;
			size = <0 12582912>;
			phandle = <333>;
		};

		audio_cma_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0 0 0 4294967295>;
			reusable;
			alignment = <0 4194304>;
			size = <0 29360128>;
			phandle = <56>;
		};

		non_secure_display_region {
			compatible = "shared-dma-pool";
			reusable;
			alloc-ranges = <0 0 0 4294967295>;
			size = <0 96468992>;
			alignment = <0 4194304>;
			phandle = <57>;
		};

		/*
		 * rocknix-abl / Qualcomm ABL keep the display alive only if a
		 * reserved-memory node is named exactly "splash_region".
		 * Matches chosen/framebuffer@b8000000 continuous splash.
		 */
		splash_region: splash_region@b8000000 {
			reg = <0x0 0xb8000000 0x0 0x2b00000>;
			label = "cont_splash_region";
			no-map;
		};

		cnss_wlan_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0 0 0 4294967295>;
			reusable;
			alignment = <0 4194304>;
			size = <0 33554432>;
			status = "disabled";
			phandle = <488>;
		};
	};

	mem-offline {
		compatible = "qcom,mem-offline";
		offline-sizes = <1 1073741824 0 1073741824 1 3221225472 0 2147483648 2 3221225472 1 1073741824>;
		granule = <512>;
		mboxes = <2 0>;
	};

	aliases {
		swr3 = "/soc/spf_core_platform/lpass-cdc/wsa2-macro@31E0000/wsa2_swr_master";
		swr2 = "/soc/spf_core_platform/lpass-cdc/va-macro@33F0000/va_swr_master";
		swr1 = "/soc/spf_core_platform/lpass-cdc/rx-macro@3200000/rx_swr_master";
		swr0 = "/soc/spf_core_platform/lpass-cdc/wsa-macro@3240000/wsa_swr_master";
		serial0 = "/soc/qcom,qup_uart@a88000";
		serial1 = "/soc/qcom,qup_uart@980000";
		hsuart0 = "/soc/qcom,qup_uart@988000";
		ufshc1 = "/soc/ufshc@1d84000";
		mmc0 = "/soc/sdhci@7C4000";
		mmc1 = "/soc/sdhci@8804000";
		spi3 = "/soc/spi@98c000";
		phandle = <528>;
	};

	sram@17D09100 {
		#address-cells = <2>;
		#size-cells = <2>;
		compatible = "mmio-sram";
		reg = <0x0 0x17d09100 0x0 0x200>;
		ranges = <0 0 0 399544576 0 512>;
		phandle = <529>;

		scp-shmem@0 {
			compatible = "arm,scp-shmem";
			reg = <0x0 0x0 0x0 0x200>;
			phandle = <303>;
		};
	};

	firmware {
		phandle = <530>;

		qcom_scm {
			compatible = "qcom,scm";
			qcom,dload-mode = <3 77824>;
		};

		qtee_shmbridge {
			compatible = "qcom,tee-shared-memory-bridge";
		};

		qcom_smcinvoke {
			compatible = "qcom,smcinvoke";
		};

		android {
			compatible = "android,firmware";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot,system,vendor,dtbo,recovery";
			};
		};
	};

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x0 0x0>;
			capacity-dmips-mhz = <1024>;
			dynamic-power-coefficient = <100>;
			enable-method = "psci";
			cpu-idle-states = <4 5>;
			power-domains = <6>;
			power-domain-names = "psci";
			qcom,freq-domain = <7 0 8>;
			next-level-cache = <8>;
			#cooling-cells = <2>;
			phandle = <26>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <2>;
				next-level-cache = <9>;
				phandle = <8>;

				l3-cache {
					compatible = "arm,arch-cache";
					cache-level = <3>;
					phandle = <9>;
				};
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x0 0x100>;
			capacity-dmips-mhz = <1024>;
			dynamic-power-coefficient = <100>;
			enable-method = "psci";
			cpu-idle-states = <4 5>;
			power-domains = <10>;
			power-domain-names = "psci";
			qcom,freq-domain = <7 0 8>;
			next-level-cache = <11>;
			#cooling-cells = <2>;
			phandle = <27>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <2>;
				next-level-cache = <9>;
				phandle = <11>;
			};
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x0 0x200>;
			capacity-dmips-mhz = <1024>;
			dynamic-power-coefficient = <100>;
			enable-method = "psci";
			cpu-idle-states = <4 5>;
			power-domains = <12>;
			power-domain-names = "psci";
			qcom,freq-domain = <7 0 8>;
			next-level-cache = <13>;
			#cooling-cells = <2>;
			phandle = <28>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <2>;
				next-level-cache = <9>;
				phandle = <13>;
			};
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x0 0x300>;
			capacity-dmips-mhz = <1024>;
			dynamic-power-coefficient = <100>;
			enable-method = "psci";
			cpu-idle-states = <4 5>;
			power-domains = <14>;
			power-domain-names = "psci";
			qcom,freq-domain = <7 0 8>;
			next-level-cache = <15>;
			#cooling-cells = <2>;
			phandle = <29>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <2>;
				next-level-cache = <9>;
				phandle = <15>;
			};
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x0 0x400>;
			capacity-dmips-mhz = <1024>;
			dynamic-power-coefficient = <100>;
			enable-method = "psci";
			cpu-idle-states = <4 5>;
			power-domains = <16>;
			power-domain-names = "psci";
			next-level-cache = <17>;
			#cooling-cells = <2>;
			qcom,freq-domain = <7 0 8>;
			phandle = <30>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <2>;
				next-level-cache = <9>;
				phandle = <17>;
			};
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x0 0x500>;
			capacity-dmips-mhz = <1024>;
			dynamic-power-coefficient = <100>;
			enable-method = "psci";
			cpu-idle-states = <4 5>;
			power-domains = <18>;
			power-domain-names = "psci";
			qcom,freq-domain = <7 0 8>;
			next-level-cache = <19>;
			#cooling-cells = <2>;
			phandle = <31>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <2>;
				next-level-cache = <9>;
				phandle = <19>;
			};
		};

		cpu@600 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x0 0x600>;
			capacity-dmips-mhz = <1945>;
			dynamic-power-coefficient = <483>;
			enable-method = "psci";
			cpu-idle-states = <20 21>;
			power-domains = <22>;
			power-domain-names = "psci";
			qcom,freq-domain = <7 1 8>;
			next-level-cache = <23>;
			#cooling-cells = <2>;
			phandle = <32>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <2>;
				next-level-cache = <9>;
				phandle = <23>;
			};
		};

		cpu@700 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x0 0x700>;
			capacity-dmips-mhz = <1945>;
			dynamic-power-coefficient = <483>;
			enable-method = "psci";
			cpu-idle-states = <20 21>;
			power-domains = <24>;
			power-domain-names = "psci";
			qcom,freq-domain = <7 1 8>;
			next-level-cache = <25>;
			#cooling-cells = <2>;
			phandle = <33>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <2>;
				next-level-cache = <9>;
				phandle = <25>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <26>;
				};

				core1 {
					cpu = <27>;
				};

				core2 {
					cpu = <28>;
				};

				core3 {
					cpu = <29>;
				};

				core4 {
					cpu = <30>;
				};

				core5 {
					cpu = <31>;
				};
			};

			cluster1 {

				core0 {
					cpu = <32>;
				};

				core1 {
					cpu = <33>;
				};
			};
		};
	};

	idle-states {
		entry-method = "psci";

		silver-c3 {
			compatible = "arm,idle-state";
			idle-state-name = "pc";
			entry-latency-us = <350>;
			exit-latency-us = <900>;
			min-residency-us = <1774>;
			arm,psci-suspend-param = <1073741827>;
			local-timer-stop;
			phandle = <4>;
		};

		silver-c4 {
			compatible = "arm,idle-state";
			idle-state-name = "rail-pc";
			entry-latency-us = <800>;
			exit-latency-us = <750>;
			min-residency-us = <4090>;
			arm,psci-suspend-param = <1073741828>;
			local-timer-stop;
			phandle = <5>;
		};

		gold-c3 {
			compatible = "arm,idle-state";
			idle-state-name = "pc";
			entry-latency-us = <400>;
			exit-latency-us = <1550>;
			min-residency-us = <2207>;
			arm,psci-suspend-param = <1073741827>;
			local-timer-stop;
			phandle = <20>;
		};

		gold-c4 {
			compatible = "arm,idle-state";
			idle-state-name = "rail-pc";
			entry-latency-us = <600>;
			exit-latency-us = <1550>;
			min-residency-us = <4791>;
			arm,psci-suspend-param = <1073741828>;
			local-timer-stop;
			phandle = <21>;
		};

		cluster-d4 {
			compatible = "domain-idle-state";
			idle-state-name = "l3-off";
			entry-latency-us = <1050>;
			exit-latency-us = <2500>;
			min-residency-us = <5309>;
			arm,psci-suspend-param = <1090519108>;
			phandle = <299>;
		};

		cx-ret {
			compatible = "domain-idle-state";
			idle-state-name = "cx-ret";
			entry-latency-us = <1561>;
			exit-latency-us = <2801>;
			min-residency-us = <8550>;
			arm,psci-suspend-param = <1090532164>;
			phandle = <300>;
		};
	};

	soc {
		interrupt-parent = <1>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0 0 0 4294967295>;
		compatible = "simple-bus";
		phandle = <531>;

		kgsl-smmu@3da0000 {
			status = "disabled";
			compatible = "qcom,qsmmu-v500\0qcom,adreno-smmu";
			reg = <0x3da0000 0x10000 0x3dc2000 0x20>;
			reg-names = "base\0tcu-base";
			#iommu-cells = <2>;
			qcom,use-3-lvl-tables;
			qcom,num-context-banks-override = <5>;
			qcom,num-smr-override = <7>;
			#global-interrupts = <1>;
			#size-cells = <1>;
			#address-cells = <1>;
			ranges;
			dma-coherent;
