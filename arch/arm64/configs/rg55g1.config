# RG55G1 fragment: framebuffer console + USB HID keyboard + bring-up aids

CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_CONSOLE_SLEEP=y
CONFIG_UNIX98_PTYS=y

# Classic simplefb+fbcon (not simpledrm)
# CONFIG_DRM_SIMPLEDRM is not set
# CONFIG_DRM_EFIDRM is not set

CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONTS=y
CONFIG_FONT_8x8=y
CONFIG_FONT_8x16=y
# CONFIG_LOGO is not set

# Clearer font; fw_devlink=off avoids hang on stock dtbo self-proxy regulators
CONFIG_CMDLINE="console=tty0 earlycon ignore_loglevel loglevel=7 log_buf_len=2M fbcon=font:VGA8x16 rdinit=/init transparent_hugepage=never fw_devlink=off clk_ignore_unused pd_ignore_unused regulator_ignore_unused"
CONFIG_CMDLINE_FORCE=y

# Embedded initramfs (rocknix-abl bootimg ramdisk is "dummy"; /init lives here).
# CONFIG_INITRAMFS_SOURCE is set to an absolute path by build_rocknix_kernel.sh.
CONFIG_INITRAMFS_ROOT_UID=0
CONFIG_INITRAMFS_ROOT_GID=0
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
# CONFIG_INITRAMFS_COMPRESSION_NONE is not set
CONFIG_INITRAMFS_FORCE=y

# HugeTLB line is normal; disable fs to reduce noise / avoid looking "stuck"
# CONFIG_HUGETLBFS is not set

CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
# CONFIG_PSTORE_COMPRESS is not set
CONFIG_PSTORE_DEFAULT_KMSG_BYTES=65536

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y

CONFIG_DRM_MSM=m

# USB host needs GCC clock provider during probe
CONFIG_SM_GCC_4450=y
CONFIG_SM_DISPCC_4450=m

# USB + HID keyboard (host / OTG adapter)
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_HID=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_USB_HIDDEV=y

# PHYs needed by stock USB nodes (built-in so keyboard can appear before modules)
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_USB_LEGACY=y
CONFIG_USB_NOP_XCEIV=y

# Optional: USB gadget serial when plugged to a PC (type from host terminal)
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_F_ACM=y
CONFIG_USB_U_SERIAL=y

# Avoid host openssl dependency for extract-cert
# CONFIG_SYSTEM_TRUSTED_KEYRING is not set
# CONFIG_SYSTEM_REVOCATION_LIST is not set
# CONFIG_MODULE_SIG_KEY is not set
CONFIG_REGULATOR_QCOM_USB_VBUS=y

# SPMI: main arb (EE-owned) + debug arb (bypass EE for PM7250B OTG)
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_SPMI_MSM_PMIC_ARB_DEBUG=y

# Battery / USB power_supply (rg55g1_bringup SPMI QG + CHGR)
CONFIG_POWER_SUPPLY=y

# MMC / SDHCI (SD slot) — /dev/mmcblk*
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_MMC_CQHCI=y

# SD card mount (vfat/ext4 register at device_initcall — brought up in rg55g1_subsys_bringup)
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EXT4_FS=y
CONFIG_MSDOS_PARTITION=y
