# RG55G1 fragment: DRM (simpledrm) + fbcon splash + USB HID + bring-up aids

CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_CONSOLE_SLEEP=y
CONFIG_UNIX98_PTYS=y

# Continuous splash @ 0xb8000000 → /dev/fb0 (rg55 splash).
# With rg55g1.msm=1: MSM KMS + Adreno GPU handoff (dispcc/gpucc/mdss/gpu).
# Without: simpledrm fallback keeps ABL splash console.
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_CLIENT_SELECTION=y
CONFIG_DRM_CLIENT_SETUP=y
CONFIG_DRM_CLIENT_DEFAULT_FBDEV=y
# CONFIG_DRM_EFIDRM is not set

CONFIG_FB=y
# CONFIG_FB_SIMPLE is not set
# CONFIG_FB_EFI is not set
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONTS=y
CONFIG_FONT_8x8=y
CONFIG_FONT_8x16=y
# CONFIG_LOGO is not set

# Clearer font; fw_devlink=off avoids hang on stock dtbo self-proxy regulators.
# boot=/disk= required by Rocknix /init (mount LABEL=ROCKNIX + STORAGE).
# rg55g1.msm=1: enable MSM DRM KMS + Adreno 613 after USB/SDHCI settle.
# rg55g1.lv6=1: full device_initcall on mainline DT (USB/SDHCI/SMMU/CH340).
# Do NOT set debugging/break=* — that permanently drops to initramfs shell.
CONFIG_CMDLINE="boot=LABEL=ROCKNIX disk=LABEL=STORAGE rootwait console=tty0 earlycon ignore_loglevel loglevel=7 log_buf_len=2M fbcon=font:VGA8x16 transparent_hugepage=never fw_devlink=off clk_ignore_unused pd_ignore_unused regulator_ignore_unused progress TERM=linux initramfs_async=0 rdinit=/init rg55g1.lv6=1 rg55g1.msm=1"
CONFIG_CMDLINE_FORCE=y

# Embedded initramfs (rocknix-abl bootimg ramdisk is "dummy"; /init lives here).
# CONFIG_INITRAMFS_SOURCE is set to an absolute path by build_rocknix_kernel.sh.
CONFIG_INITRAMFS_ROOT_UID=0
CONFIG_INITRAMFS_ROOT_GID=0
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
# CONFIG_INITRAMFS_COMPRESSION_NONE is not set
CONFIG_INITRAMFS_FORCE=y

# HugeTLB line is normal; disable fs to reduce noise / avoid looking "stuck"
# CONFIG_HUGETLBFS is not set

CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
# CONFIG_PSTORE_COMPRESS is not set
CONFIG_PSTORE_DEFAULT_KMSG_BYTES=65536

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y

# Built-in: rg55g1_populate_msm_display() runs at fs_initcall (LV6 skipped).
# LLCC/OCMEM as modules force olddefconfig to demote DRM_MSM=y → =m.
# CONFIG_QCOM_LLCC is not set
# CONFIG_QCOM_OCMEM is not set
# CONFIG_DRM_MSM is not set
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_GPU_STATE=y
CONFIG_DRM_MSM_KMS=y
CONFIG_DRM_MSM_KMS_FBDEV=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_MDSS=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_PANEL_FOCALTECH_FT7131M=y

# USB host needs GCC clock provider during probe
CONFIG_SM_GCC_4450=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_SM_DISPCC_4450=y
CONFIG_SM_GPUCC_4450=y

# SM4450 interconnect (USB/SDHCI/MDSS bandwidth — ROCKNIX 0006)
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM4450=y
CONFIG_INTERCONNECT_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM_BCM_VOTER=y

# Apps/Adreno SMMU (ROCKNIX 0008)
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_IO_PGTABLE_LPAE=y

# QFPROM for Adreno speed_bin
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_QCOM_RPMHPD=y
CONFIG_PM_OPP=y
# USB host + gadget (OTG) + HID keyboard
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_UDC_CORE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_HID=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_USB_HIDDEV=y

# CH340G USB-UART on OTG port -> /dev/ttyUSB0 (rg55g1_log_export.c)
# Must be =y (not module): LV6 device_initcall is skipped; rg55g1_usb_serial_bringup()
# manually calls usb_serial_init() + ch341_init() before USB host populate.
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CH341=y

CONFIG_QCOM_UBWC_CONFIG=y
CONFIG_QCOM_SMEM=y

# PHYs needed by stock USB nodes (built-in so keyboard can appear before modules)
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_USB_LEGACY=y
CONFIG_USB_NOP_XCEIV=y

# USB gadget serial when plugged to a PC (configure via configfs from userspace)
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_F_ACM=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_F_SERIAL=y

# Avoid host openssl dependency for extract-cert
# (CFG80211_REQUIRE_SIGNED_REGDB selects SYSTEM_DATA_VERIFICATION → TRUSTED_KEYRING)
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
# CONFIG_SYSTEM_TRUSTED_KEYRING is not set
# CONFIG_SYSTEM_REVOCATION_LIST is not set
# CONFIG_MODULE_SIG_KEY is not set
CONFIG_REGULATOR_QCOM_USB_VBUS=y

# SPMI: main arb (EE-owned) + debug arb (bypass EE for PM7250B OTG)
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_SPMI_MSM_PMIC_ARB_DEBUG=y

# Battery / USB power_supply (rg55g1_bringup SPMI QG + CHGR)
CONFIG_POWER_SUPPLY=y

# MMC / SDHCI (SD slot) — /dev/mmcblk*
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_MMC_CQHCI=y

# SD card mount (vfat/ext4 register at device_initcall — brought up in rg55g1_subsys_bringup)
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EXT4_FS=y
CONFIG_MSDOS_PARTITION=y

# SquashFS (Rocknix SYSTEM is zstd; also enable common compressors + overlay/loop)
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8

# Gamepad: GPIO buttons + SPI MCU analog sticks
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_SINGLE_ADC=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_PINCTRL_SM4450=y
CONFIG_GPIOLIB=y

# Power / volume keys (PMIC PON + TLMM gpio53) -> /dev/input/event*
CONFIG_KEYBOARD_RG55G1=y
